rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function canReadAssignmentPeriod() {
      return signedIn() && (
        request.auth.uid == resource.data.tutorId
        || request.auth.uid == resource.data.studentId
        || isAdmin()
        || get(/databases/$(database)/documents/users/$(resource.data.studentId)).data.parentId == request.auth.uid
      );
    }

    match /{topLevelCollection}/{document=**} {
      allow read: if topLevelCollection != 'subscriptionAuthorizations'
        && topLevelCollection != 'tutorStudentAssignmentPeriods'
        && topLevelCollection != 'staffStudentAccessPeriods'
        && topLevelCollection != 'topicResolverMappings';
      allow write: if topLevelCollection != 'subscriptions'
        && topLevelCollection != 'payments'
        && topLevelCollection != 'subscriptionAuthorizations'
        && topLevelCollection != 'tutorStudentAssignments'
        && topLevelCollection != 'staffStudentAccess'
        && topLevelCollection != 'tutorStudentAssignmentPeriods'
        && topLevelCollection != 'staffStudentAccessPeriods'
        && topLevelCollection != 'topicResolverMappings';
    }

    match /users/{userId}/subjects/{subjectInstanceId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || request.auth.uid in resource.data.activeStaffIds
        || isAdmin()
        || get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid
      );
      allow write: if isAdmin() || (signedIn() && (request.auth.uid == userId || request.auth.uid in resource.data.activeStaffIds));

      match /{subcollection}/{docId=**} {
        allow read: if signedIn() && (
          request.auth.uid == userId
          || isAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/subjects/$(subjectInstanceId)).data.activeStaffIds
          || get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid
        );
        allow write: if signedIn() && (
          request.auth.uid == userId
          || isAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/subjects/$(subjectInstanceId)).data.activeStaffIds
        );
      }
    }

    match /{path=**}/subjects/{subjectInstanceId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.studentId
        || request.auth.uid in resource.data.activeStaffIds
        || isAdmin()
      );
    }

    match /users/{userId}/subscriptionAuthorizations/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/subscriptions/{document=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid);
      allow write: if false;
    }

    match /users/{userId}/payments/{paymentId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || resource.data.payerId == request.auth.uid || get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid);
      allow write: if false;
    }

    match /{path=**}/peerMarkingAssignments/{assignmentId} {
      allow read: if signedIn() && (
        resource.data.reviewerId == request.auth.uid
        || resource.data.revieweeId == request.auth.uid
        || isAdmin()
        || (resource.data.activeStaffIds != null && request.auth.uid in resource.data.activeStaffIds)
      );
    }

    match /topicResolverMappings/{mappingId} {
      allow read, write: if isAdmin();
    }

    match /tutorStudentAssignmentPeriods/{periodId} {
      allow read: if canReadAssignmentPeriod();
      allow write: if false;
    }

    match /staffStudentAccessPeriods/{periodId} {
      allow read: if canReadAssignmentPeriod();
      allow write: if false;
    }
  }
}
