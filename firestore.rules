rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isAdmin() { return signedIn() && profile(request.auth.uid).role == 'admin'; }
    function isParentOf(studentId) { return signedIn() && profile(studentId).get('parentId', '') == request.auth.uid; }
    function validSelfProfileUpdate(userId) {
      return signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'parentId', 'paymentCompleted', 'subscriptionStatus', 'subscriptionPlanId',
          'subscriptionPlanName', 'subscriptionSubjectCount', 'subscriptionBillingPeriod',
          'subscriptionRenewalDate', 'latestPaymentReference', 'latestReference',
          'renewalDate', 'graceEndsAt', 'subject', 'subjects', 'grade',
          'activeStaffIds', 'activeStudentIds', 'primaryTutorId'
        ]) == false;
    }
    function validParentProfileUpdate(userId) {
      return isParentOf(userId)
        && request.resource.data.parentId == resource.data.parentId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'previousYearMark', 'updatedAt'
        ]);
    }
    function episode(studentId, subjectInstanceId) {
      return get(/databases/$(database)/documents/users/$(studentId)/subjects/$(subjectInstanceId)).data;
    }
    function isEpisodeStaff(studentId, subjectInstanceId) {
      return signedIn() && request.auth.uid in episode(studentId, subjectInstanceId).get('activeStaffIds', []);
    }
    function isPrimaryTutor(studentId, subjectInstanceId) {
      return signedIn() && episode(studentId, subjectInstanceId).get('status', '') == 'active'
        && episode(studentId, subjectInstanceId).get('primaryTutorId', '') == request.auth.uid;
    }
    function isHistoricalEpisodeStaff(studentId, subjectInstanceId) {
      return signedIn() && request.auth.uid in episode(studentId, subjectInstanceId).get('historicalStaffIds', []);
    }
    function canTeach(studentId, subjectInstanceId) {
      return isPrimaryTutor(studentId, subjectInstanceId)
        || (isEpisodeStaff(studentId, subjectInstanceId)
          && episode(studentId, subjectInstanceId).get('staffByUid', {}).get(request.auth.uid, '') == 'co-owner');
    }
    function canMark(studentId, subjectInstanceId) {
      return canTeach(studentId, subjectInstanceId)
        || (isEpisodeStaff(studentId, subjectInstanceId)
          && episode(studentId, subjectInstanceId).get('staffByUid', {}).get(request.auth.uid, '') == 'marker');
    }
    function validStudentGenerationRun(studentId, subjectInstanceId) {
      return signedIn() && request.auth.uid == studentId
        && request.resource.data.studentId == studentId
        && request.resource.data.subjectInstanceId == subjectInstanceId
        && request.resource.data.subject == episode(studentId, subjectInstanceId).subjectKey
        && episode(studentId, subjectInstanceId).status == 'active';
    }
    function canReadEpisode(studentId, subjectInstanceId) {
      return signedIn() && (request.auth.uid == studentId || isParentOf(studentId) || isAdmin()
        || isPrimaryTutor(studentId, subjectInstanceId) || isEpisodeStaff(studentId, subjectInstanceId)
        || isHistoricalEpisodeStaff(studentId, subjectInstanceId));
    }
    function exerciseIsOpen() {
      return resource.data.assignmentOpensAt <= request.time && request.time < resource.data.locksAt;
    }
    function hasPaidAccess(studentId) {
      let subscriptionPath = /databases/$(database)/documents/users/$(studentId)/subscriptions/current;
      return exists(subscriptionPath)
        && get(subscriptionPath).data.planId in ['circle', 'personalized']
        && ((get(subscriptionPath).data.status == 'active' && get(subscriptionPath).data.renewalDate > request.time)
          || (get(subscriptionPath).data.status == 'past_due' && get(subscriptionPath).data.graceEndsAt > request.time));
    }
    function lessonIdentityIsUnchanged(subjectInstanceId) {
      return request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
        && request.resource.data.get('tutorId', '') == resource.data.get('tutorId', '')
        && request.resource.data.get('subject', '') == resource.data.get('subject', '')
        && request.resource.data.get('subjectInstanceId', subjectInstanceId) == subjectInstanceId
        && request.resource.data.get('sessionMode', 'one-on-one') == resource.data.get('sessionMode', 'one-on-one')
        && request.resource.data.get('groupSessionId', '') == resource.data.get('groupSessionId', '')
        && request.resource.data.get('lessonDate', '') == resource.data.get('lessonDate', '');
    }
    function validPlannedLessonDetailsUpdate(studentId, subjectInstanceId) {
      return canTeach(studentId, subjectInstanceId)
        && resource.data.status == 'planned'
        && request.resource.data.status == 'planned'
        && lessonIdentityIsUnchanged(subjectInstanceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lessonType', 'whatsappLessonLink', 'locationDetails', 'updatedAt'
        ]);
    }
    function validLessonOutcomeUpdate(studentId, subjectInstanceId) {
      return canTeach(studentId, subjectInstanceId)
        && resource.data.status in ['planned', 'incomplete', 'lesson_log_pending']
        && request.resource.data.status in ['completed', 'missed']
        && lessonIdentityIsUnchanged(subjectInstanceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lessonId', 'topics', 'topic', 'topicReport', 'note', 'topicUnderstandingScores',
          'understandingLevel', 'status', 'attendanceStatus', 'attended', 'completedOn',
          'lessonType', 'whatsappLessonLink', 'locationDetails', 'assignmentPeriodId', 'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ['student', 'tutor', 'teacher', 'parent']
        && (request.resource.data.role != 'student' || request.resource.data.paymentCompleted == false);
      allow update: if isAdmin() || validSelfProfileUpdate(userId) || validParentProfileUpdate(userId);
      allow delete: if isAdmin();

      match /subjects/{subjectInstanceId} {
        allow read: if canReadEpisode(userId, subjectInstanceId);
        allow update: if isAdmin() || (canTeach(userId, subjectInstanceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'completedTopicCount', 'dailyExerciseTarget', 'updatedAt'
          ]));
        allow create, delete: if false;

        match /topics/{topicKey} {
          allow read: if canReadEpisode(userId, subjectInstanceId);
          allow create: if isAdmin() || (canMark(userId, subjectInstanceId)
            && request.resource.data.canonicalTopicKey == topicKey
            && request.resource.data.topicName is string
            && request.resource.data.topicName.size() > 0
            && request.resource.data.understandingLevel is number
            && request.resource.data.understandingLevel >= 0
            && request.resource.data.understandingLevel <= 1
            && request.resource.data.understandingScale == 'ratio-0-to-1');
          allow update: if isAdmin() || (canMark(userId, subjectInstanceId)
            && request.resource.data.canonicalTopicKey == topicKey
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastCoveredAt', 'tutorReport', 'updatedAt', 'topicStatus', 'attendanceStatus', 'firstCompletedAt'
            ]));
          allow delete: if isAdmin();
          match /understandingScores/{scoreId} {
            allow read: if canReadEpisode(userId, subjectInstanceId);
            allow create: if isAdmin() || (canMark(userId, subjectInstanceId)
              && request.resource.data.sourceType == 'Lesson'
              && request.resource.data.score is number
              && request.resource.data.score >= 0 && request.resource.data.score <= 1
              && request.resource.data.scoreScale == 'ratio-0-to-1'
              && request.resource.data.sourceId is string
              && request.resource.data.tutorId == request.auth.uid);
            allow update, delete: if false;
          }
        }
        match /lessons/{lessonId} {
          allow read: if canReadEpisode(userId, subjectInstanceId);
          allow create: if isAdmin();
          allow update: if isAdmin()
            || validPlannedLessonDetailsUpdate(userId, subjectInstanceId)
            || validLessonOutcomeUpdate(userId, subjectInstanceId);
          allow delete: if isAdmin();
        }
        match /reports/{reportId} {
          allow read: if canReadEpisode(userId, subjectInstanceId);
          allow create, update, delete: if isAdmin() || canTeach(userId, subjectInstanceId);
        }
        match /generationRuns/{dateKey} {
          allow read: if canReadEpisode(userId, subjectInstanceId);
          allow write: if isAdmin() || canTeach(userId, subjectInstanceId) || validStudentGenerationRun(userId, subjectInstanceId);
        }
        match /exercises/{exerciseId} {
          allow read: if canReadEpisode(userId, subjectInstanceId);
          allow create: if isAdmin() || canTeach(userId, subjectInstanceId)
            || (signedIn() && request.auth.uid == userId && hasPaidAccess(userId)
              && request.resource.data.studentId == userId
              && request.resource.data.subjectInstanceId == subjectInstanceId);
          allow delete: if isAdmin() || canTeach(userId, subjectInstanceId);
          allow update: if isAdmin() || canMark(userId, subjectInstanceId)
            || (signedIn() && request.auth.uid == userId && exerciseIsOpen()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'submittedImageUrl', 'submittedImages', 'submittedFileName', 'submittedFileNames',
                'submissionPageCount', 'submittedAt', 'updatedAt', 'peerReviewed',
                'peerReviewStatus', 'peerNotes', 'peerReviewDate', 'submitted', 'submissionStatus'
              ]));
          match /submissions/{submissionId} {
            allow read: if canReadEpisode(userId, subjectInstanceId);
            allow create, update: if signedIn() && request.auth.uid == userId
              && get(/databases/$(database)/documents/users/$(userId)/subjects/$(subjectInstanceId)/exercises/$(exerciseId)).data.assignmentOpensAt <= request.time
              && request.time < get(/databases/$(database)/documents/users/$(userId)/subjects/$(subjectInstanceId)/exercises/$(exerciseId)).data.locksAt;
            allow write: if isAdmin() || canMark(userId, subjectInstanceId);
          }
          match /peerMarkingAssignments/{assignmentId} {
            allow read: if signedIn() && (resource.data.reviewerId == request.auth.uid || resource.data.revieweeId == request.auth.uid || isAdmin() || isEpisodeStaff(userId, subjectInstanceId));
            allow write: if false;
          }
          match /peerReviews/{reviewId} {
            allow read: if canReadEpisode(userId, subjectInstanceId) || (signedIn() && resource.data.reviewerId == request.auth.uid);
            allow write: if false;
          }
        }
      }

      match /subscriptions/{document=**} {
        allow read: if signedIn() && (request.auth.uid == userId || isParentOf(userId) || isAdmin());
        allow write: if false;
      }
      match /subscriptionAuthorizations/{document=**} { allow read, write: if false; }
      match /payments/{paymentId} {
        allow read: if signedIn() && (request.auth.uid == userId || resource.data.payerId == request.auth.uid || isParentOf(userId) || isAdmin());
        allow write: if false;
      }
      match /guideQuizResults/{document=**} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
      match /notifications/{document=**} {
        allow read, update, delete: if signedIn() && request.auth.uid == userId;
        allow create: if false;
      }
      // Tutor contact information and per-subject invite links are returned only
      // by callables that verify the owner or the student's exact lesson access.
      match /private/{document=**} { allow read, write: if false; }
      match /tutorSubjectSettings/{document=**} { allow read, write: if false; }
      match /notificationTokens/{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      match /notificationLogs/{document=**} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
      match /tutorMarksDocuments/{document=**} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /{path=**}/subjects/{subjectInstanceId} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid
        || request.auth.uid in resource.data.activeStaffIds
        || resource.data.primaryTutorId == request.auth.uid
        || request.auth.uid in resource.data.historicalStaffIds || isAdmin());
    }
    match /{path=**}/lessons/{lessonId} {
      allow read: if isAdmin();
    }
    match /{path=**}/peerMarkingAssignments/{assignmentId} {
      allow read: if signedIn() && resource.data.reviewerId == request.auth.uid;
    }
    match /{path=**}/generationRuns/{runId} {
      allow read: if canReadEpisode(resource.data.studentId, resource.data.subjectInstanceId);
    }
    match /questionPapers/{paperId} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && profile(request.auth.uid).role in ['tutor', 'teacher']);
      match /{document=**} { allow read: if signedIn(); allow write: if false; }
    }
    match /subjects/{subjectName} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /grades/{gradeName} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }
    match /topicResolverMappings/{mappingId} { allow read, write: if isAdmin(); }
    match /settings/{settingId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /discountCodes/{codeId} {
      allow read, write: if false;
      match /redemptions/{redemptionId} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
