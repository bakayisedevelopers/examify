rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile(uid) { return firestore.get(/databases/(default)/documents/users/$(uid)).data; }
    function isAdmin() { return signedIn() && profile(request.auth.uid).role == 'admin'; }
    function episode(studentId, subjectInstanceId) {
      return firestore.get(/databases/(default)/documents/users/$(studentId)/subjects/$(subjectInstanceId)).data;
    }
    function isStaff(studentId, subjectInstanceId) {
      return signedIn() && request.auth.uid in episode(studentId, subjectInstanceId).activeStaffIds;
    }
    function canMark(studentId, subjectInstanceId) {
      return isStaff(studentId, subjectInstanceId)
        && episode(studentId, subjectInstanceId).staffByUid[request.auth.uid] in ['co-owner', 'marker'];
    }
    function validImage() { return request.resource.size < 15 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    function assignmentIsToday(assignmentDate) {
      let parts = assignmentDate.split('-');
      return assignmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]))
          == (request.time + duration.value(2, 'h')).date();
    }
    function exerciseSubmissionIsOpen(studentId, subjectInstanceId, exerciseId) {
      let exercise = firestore.get(/databases/(default)/documents/users/$(studentId)/subjects/$(subjectInstanceId)/exercises/$(exerciseId)).data;
      let hasAccessWindow = exercise.keys().hasAll(['assignmentOpensAt', 'locksAt'])
        && exercise.assignmentOpensAt is timestamp
        && exercise.locksAt is timestamp;
      return hasAccessWindow
        ? exercise.assignmentOpensAt <= request.time && request.time < exercise.locksAt
        : assignmentIsToday(exercise.get('assignmentDate', ''));
    }

    match /questionPaperAnalysis/{allPaths=**} { allow read, write: if false; }
    match /questionPapers/{uploaderId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uploaderId || isAdmin());
    }
    match /users/{studentId}/subjects/{subjectInstanceId}/exercises/{exerciseId}/submissions/{fileName} {
      allow read: if signedIn() && (request.auth.uid == studentId || isStaff(studentId, subjectInstanceId) || isAdmin()
        || firestore.exists(/databases/(default)/documents/users/$(studentId)/subjects/$(subjectInstanceId)/exercises/$(exerciseId)/peerMarkingAssignments/$(request.auth.uid)));
      allow create: if signedIn() && request.auth.uid == studentId && validImage()
        && exerciseSubmissionIsOpen(studentId, subjectInstanceId, exerciseId);
      allow update, delete: if false;
    }
    match /users/{studentId}/subjects/{subjectInstanceId}/exercises/{exerciseId}/{folder}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == studentId || isStaff(studentId, subjectInstanceId) || isAdmin());
      allow create: if validImage() && ((folder == 'tutor-marking' && (canMark(studentId, subjectInstanceId) || isAdmin()))
        || (folder == 'peer-reviews' && signedIn() && request.auth.uid == studentId));
      allow update, delete: if folder in ['tutor-marking', 'peer-reviews']
        && (canMark(studentId, subjectInstanceId) || isAdmin() || (folder == 'peer-reviews' && request.auth.uid == studentId));
    }
    match /users/{userId}/tutorMarksDocuments/{allPaths=**} {
      allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
